            ) : accidentCases.map((c) => {
              const severityClass = c.severity === '重大' ? 'bg-red-500/20 text-red-400' : 'bg-orange-500/20 text-orange-400';
              const severityBorder = c.severity === '重大' ? 'border-l-red-500' : 'border-l-orange-500';
              return (
                <article class={`rounded-3xl border border-white/10 bg-white/5 p-6 border-l-4 ${severityBorder} hover:-translate-y-1 transition reveal-scale`}>
                  <div class="flex items-center justify-between mb-3">
                    <span class={`rounded-full px-3 py-1 text-xs font-bold ${severityClass}`}>{c.severity}</span>
                    <span class="text-xs text-steel-500">{c.date || ''}</span>
                  </div>
                  <h3 class="font-display text-lg font-bold text-white mb-2">{c.title}</h3>
                  <p class="text-sm text-steel-400 mb-3">{c.location || ''}</p>
                  <p class="text-sm text-steel-300 line-clamp-3">{c.description}</p>
                  <button onclick={`showCaseDetail(${c.id})`} class="mt-4 text-sm text-orange-safety hover:text-orange-safetyLight font-medium">查看详情 →</button>
                </article>
              );
            })}
          </div>
        </div>
