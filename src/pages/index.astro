---
import '../styles/global.css';
import { HeroParticles } from '../components/HeroParticles';
import { SiteParticles } from '../components/SiteParticles';
import { MobileNav } from '../components/MobileNav';
import { KnowledgeLibrarySection } from '../components/KnowledgeLibrarySection';
import { initDB } from '../lib/db';

// 服务端渲染获取事故案例
let accidentCases = [];
try {
  const db = initDB();
  const result = await db.execute('SELECT * FROM accident_cases ORDER BY date DESC');
  accidentCases = result.rows;
} catch (e) {
  console.error('Failed to load cases:', e);
}

const equipment = [
  {
    title: '风机叶片运输',
    eyebrow: 'Blade Transport',
    metric: '80–120m',
    description: '超长叶片对转弯半径、道路净空、侧风窗口和尾部扫摆控制要求极高，是风电大件运输中最具路线挑战的品类。',
    points: ['转弯半径模拟', '侧风窗口判断', '叶尖扫摆监测'],
  },
  {
    title: '塔筒分段运输',
    eyebrow: 'Tower Sections',
    metric: '60–90t',
    description: '塔筒运输关注重心、支撑鞍座、桥梁承载、坡道路段制动与多车协同，适合建立标准化检查模型。',
    points: ['桥梁承载复核', '鞍座受力检查', '坡道制动预案'],
  },
  {
    title: '机舱与发电机',
    eyebrow: 'Nacelle Logistics',
    metric: '100t+',
    description: '机舱重量集中、价值高，装卸吊点、运输震动、绑扎冗余与港口转运衔接决定交付安全边界。',
    points: ['吊点受力核查', '震动监测', '绑扎冗余设计'],
  },
  {
    title: '轮毂与关键组件',
    eyebrow: 'Hub Components',
    metric: '精密件',
    description: '轮毂、轴承、控制柜等关键组件更重视防护、标识、吊装顺序和现场交接验收，避免隐性损伤。',
    points: ['防护包装', '交接验收', '吊装顺序控制'],
  },
];

const process = [
  ['01', '工厂装车', '核对吊点、鞍座、重心线、绑扎角度与车辆轴线，形成装车前安全确认。'],
  ['02', '路线勘察', '复核桥梁、涵洞、弯道、坡度、净空、临时拆改点与交通组织方案。'],
  ['03', '特种车辆配置', '根据长度、重量和路况选择伸缩板车、液压轴线车或自走式模块车。'],
  ['04', '道路通行控制', '执行护送、封控、低速转弯、实时通讯和关键节点二次确认机制。'],
  ['05', '港口与风场转运', '管理码头吊装、堆场临存、二次绑扎、风场道路会车与吊装交付。'],
];

const risks = [
  ['侧风', '高', '叶片受风面积大，需设定停运风速阈值与实时气象监测。'],
  ['弯道扫尾', '高', '超长构件尾部侵入对向车道、护栏或山体，需要路径仿真。'],
  ['桥梁承载', '中', '塔筒与机舱重量集中，必须复核轴荷、桥梁等级与通行速度。'],
  ['绑扎失效', '高', '急刹、坡道、横风可能导致位移，需双重冗余与途中复检。'],
  ['夜间通行', '中', '视距、照明、公众交通干扰增加，需要警示车与节点封控。'],
  ['吊装交接', '高', '吊点、索具、风速、站位和指挥链错误会放大成重大事故。'],
];

const knowledge = [
  { title: '叶片运输路线勘察指南', desc: '转弯半径、道路净空、桥梁承载与侧风窗口的系统勘察方法。', slug: 'blade-route-survey' },
  { title: '塔筒运输桥梁承载核查', desc: '塔筒运输中对桥梁等级、轴荷分布与通行速度的核查流程。', slug: 'tower-bridge-load' },
  { title: '机舱装卸与绑扎固定方法', desc: '吊点、减震、绑扎冗余与途中检查的核心技术要求。', slug: 'nacelle-lashing' },
  { title: '风场道路通行风险识别', desc: '路基宽度、坡度、排水与临时道路方案的风险评估。', slug: 'wind-farm-road-risk' },
  { title: '港口转运与临时堆场安全', desc: '码头吊装、二次绑扎、堆场管理与天气防护措施。', slug: 'port-transshipment-safety' },
  { title: '恶劣天气运输窗口判断', desc: '风速、能见度、路面状态与综合天气预报的安全窗口管理。', slug: 'weather-window-assessment' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="风电大件运输安全知识中心，系统介绍风机叶片、塔筒、机舱等大件设备物流运输、路线勘察、绑扎固定、风险控制与安全作业知识。" />
    <meta name="theme-color" content="#040E1A" />

    <!-- Open Graph -->
    <meta property="og:title" content="风电大件运输安全知识中心" />
    <meta property="og:description" content="系统解析叶片、塔筒、机舱等风电大件设备从工厂到风场的运输路径、风险控制、绑扎固定与安全作业标准，为工程团队建立可执行的知识地图。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://example.com" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="风电大件运输安全知识中心" />
    <meta name="twitter:description" content="系统解析叶片、塔筒、机舱等风电大件设备从工厂到风场的运输路径、风险控制、绑扎固定与安全作业标准。" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "风电大件运输安全知识中心",
        "description": "风电大件设备物流运输、路线勘察、绑扎固定、风险控制与安全作业知识库",
        "inLanguage": "zh-CN",
        "about": ["Wind Power", "Heavy-Lift Transport", "Logistics Safety", "Wind Turbine"]
      }
    </script>

    <title>风电大件运输安全知识中心｜风电物流与安全知识库</title>
  </head>
  <body>
    <SiteParticles client:load />
    <header class="fixed left-0 right-0 top-0 z-50 px-4 pt-4 sm:px-6">
      <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-white/10 bg-navy-950/72 px-4 py-3 shadow-2xl shadow-black/30 backdrop-blur-xl sm:px-5" aria-label="主导航">
        <a href="#top" class="group flex items-center gap-3 focus:outline-none focus:ring-2 focus:ring-orange-safety focus:ring-offset-2 focus:ring-offset-navy-950">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-orange-safety/40 bg-orange-safety/10 text-orange-safety">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v18M4.5 7.5 12 12l7.5-4.5M5 17l7-5 7 5"/><circle cx="12" cy="12" r="2.2"/></svg>
          </span>
          <span>
            <span class="block font-display text-sm font-bold tracking-[0.16em] text-white sm:text-base">风电大件运输安全知识中心</span>
            <span class="hidden font-mono text-[10px] uppercase tracking-[0.28em] text-steel-400 sm:block">Heavy-Lift Safety Atlas</span>
          </span>
        </a>
        <div class="hidden items-center gap-7 text-sm text-steel-300 md:flex">
          <a href="#library" class="transition hover:text-white">知识库</a>
          <a href="#route" class="transition hover:text-white">运输流程</a>
          <a href="#risk" class="transition hover:text-white">风险矩阵</a>
          <a href="#safety-report" class="transition hover:text-white">安全检查和培训</a>
          <a href="/exam" class="transition text-orange-safety hover:text-orange-safetyLight font-bold">安全考试</a>
          <a href="#cases" class="transition hover:text-white">事故案例</a>
        </div>
        <MobileNav client:load />
        <a href="/exam" class="hidden min-h-11 items-center rounded-full bg-orange-safety px-4 py-2 text-sm font-bold text-navy-950 shadow-lg shadow-orange-safety/25 transition hover:bg-orange-safetyLight focus:outline-none focus:ring-2 focus:ring-orange-safety focus:ring-offset-2 focus:ring-offset-navy-950 sm:inline-flex">开始考试</a>
      </nav>
    </header>

    <main id="top">
      <!-- ============ HERO ============ -->
      <section class="relative min-h-screen overflow-hidden pb-20 pt-32 sm:pt-40 lg:pt-44">
        <HeroParticles client:load />
        <div class="absolute inset-0 -z-10">
          <div class="absolute left-1/2 top-28 h-[32rem] w-[72rem] -translate-x-1/2 rounded-full bg-cyan-wind/12 blur-3xl"></div>
          <div class="absolute right-[-12rem] top-24 h-[34rem] w-[34rem] rounded-full bg-orange-safety/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-navy-950 to-transparent"></div>
        </div>

        <div class="container-x grid items-center gap-14 lg:grid-cols-[1.02fr_0.98fr]">
          <div class="relative z-10">
            <p class="section-kicker opacity-0 animate-stagger-1">Wind Power Heavy-Lift Logistics</p>
            <h1 class="mt-6 max-w-4xl font-display text-5xl font-black leading-[1.15] tracking-[-0.05em] opacity-0 animate-stagger-2 sm:text-7xl lg:text-8xl">
              <span class="headline-gradient">风电大件运输</span><br />
              <span class="text-white">安全知识中心</span>
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-8 text-steel-300 opacity-0 animate-stagger-3 sm:text-xl">
              系统解析叶片、塔筒、机舱等风电大件设备从工厂到风场的运输路径、风险控制、绑扎固定与安全作业标准，为工程团队建立可执行的知识地图。
            </p>
            <div class="mt-10 flex flex-col gap-4 opacity-0 animate-stagger-4 sm:flex-row">
              <a href="#route" class="inline-flex min-h-12 items-center justify-center rounded-full bg-orange-safety px-6 py-3 font-bold text-navy-950 shadow-xl shadow-orange-safety/25 transition hover:-translate-y-0.5 hover:bg-orange-safetyLight focus:outline-none focus:ring-2 focus:ring-orange-safety focus:ring-offset-2 focus:ring-offset-navy-950">浏览运输流程</a>
              <a href="#risk" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 font-bold text-white backdrop-blur transition hover:-translate-y-0.5 hover:border-cyan-wind/50 hover:bg-cyan-wind/10 focus:outline-none focus:ring-2 focus:ring-cyan-wind focus:ring-offset-2 focus:ring-offset-navy-950">查看风险矩阵</a>
            </div>

            <div class="mt-14 grid max-w-2xl grid-cols-3 gap-3 opacity-0 animate-fade-up [animation-delay:0.55s]">
              <div class="glass-panel rounded-2xl p-4 technical-border">
                <div class="font-display text-2xl font-bold text-white">120m</div>
                <div class="mt-1.5 text-xs text-steel-400">超长叶片路径模拟</div>
              </div>
              <div class="glass-panel rounded-2xl p-4 technical-border">
                <div class="font-display text-2xl font-bold text-white">24h</div>
                <div class="mt-1.5 text-xs text-steel-400">运输窗口安全复核</div>
              </div>
              <div class="glass-panel rounded-2xl p-4 technical-border">
                <div class="font-display text-2xl font-bold text-white">HSE</div>
                <div class="mt-1.5 text-xs text-steel-400">全流程检查清单</div>
              </div>
            </div>
          </div>

          <!-- REDRAWN SVG - CINEMATIC ROUTE MONITOR -->
          <div class="relative min-h-[420px] opacity-0 animate-fade-in [animation-delay:0.3s] sm:min-h-[560px]">
            <div class="absolute inset-0 rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-white/10 via-white/[0.03] to-transparent shadow-2xl shadow-black/40 backdrop-blur-sm"></div>
            <div class="absolute inset-5 overflow-hidden rounded-[2rem] border border-white/10 bg-navy-950/60">
              <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-cyan-wind/10 to-transparent"></div>
              <div class="absolute left-5 top-5 z-20 font-mono text-[10px] uppercase tracking-[0.32em] text-cyan-wind sm:left-6 sm:top-6">Transport Monitoring / CN-WIND-09</div>

              <svg class="absolute inset-0 h-full w-full" viewBox="0 0 640 560" role="img" aria-label="风电大件运输路线监控中心">
                <defs>
                  <radialGradient id="monitorGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#22D3EE" stop-opacity="0.08"/>
                    <stop offset="100%" stop-color="#22D3EE" stop-opacity="0"/>
                  </radialGradient>
                  <linearGradient id="routeGlow" x1="0" y1="1" x2="1" y2="0">
                    <stop offset="0%" stop-color="#22D3EE" stop-opacity="0.4"/>
                    <stop offset="40%" stop-color="#94A3B8" stop-opacity="0.5"/>
                    <stop offset="75%" stop-color="#F97316" stop-opacity="0.7"/>
                    <stop offset="100%" stop-color="#F97316" stop-opacity="1"/>
                  </linearGradient>
                  <linearGradient id="trailGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#22D3EE"/>
                    <stop offset="50%" stop-color="#F97316"/>
                    <stop offset="100%" stop-color="#F97316"/>
                  </linearGradient>
                  <filter id="svgGlow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
                  <filter id="strongGlow"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
                  <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#071C37"/>
                    <stop offset="48%" stop-color="#0A2946"/>
                    <stop offset="100%" stop-color="#0B1F3A"/>
                  </linearGradient>
                  <linearGradient id="ridgeGreen" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#8CE36A" stop-opacity="0.18"/>
                    <stop offset="55%" stop-color="#22C55E" stop-opacity="0.10"/>
                    <stop offset="100%" stop-color="#0F3B2F" stop-opacity="0.32"/>
                  </linearGradient>
                  <linearGradient id="roadDeck" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#475569" stop-opacity="0.42"/>
                    <stop offset="50%" stop-color="#1E293B" stop-opacity="0.88"/>
                    <stop offset="100%" stop-color="#020617" stop-opacity="0.92"/>
                  </linearGradient>
                  <linearGradient id="bladeBody" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#E5E7EB"/>
                    <stop offset="55%" stop-color="#CBD5E1"/>
                    <stop offset="100%" stop-color="#F8FAFC"/>
                  </linearGradient>
                  <linearGradient id="redTractor" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#F97316"/>
                    <stop offset="45%" stop-color="#DC2626"/>
                    <stop offset="100%" stop-color="#7F1D1D"/>
                  </linearGradient>
                  <pattern id="gridPattern" width="32" height="32" patternUnits="userSpaceOnUse">
                    <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="0.5"/>
                  </pattern>
                </defs>

                <!-- Background -->
                <rect width="640" height="560" fill="url(#skyGrad)"/>
                <rect width="640" height="560" fill="url(#gridPattern)"/>
                <rect width="640" height="560" fill="url(#monitorGlow)"/>

                <!-- Deep blue sky + live-monitor overlay -->
                <rect width="640" height="560" fill="url(#skyGrad)"/>
                <rect width="640" height="560" fill="url(#gridPattern)"/>
                <rect width="640" height="560" fill="url(#monitorGlow)"/>

                <!-- Blue daylight glow inspired by the reference photo, toned down for industrial dark UI -->
                <ellipse cx="355" cy="98" rx="270" ry="110" fill="rgba(125,211,252,0.12)"/>
                <ellipse cx="320" cy="480" rx="340" ry="120" fill="rgba(34,211,238,0.04)"/>

                <!-- Layered green mountain ridges from blade-transport reference -->
                <g>
                  <path d="M0 178 C52 138 98 126 148 144 C208 166 244 112 300 132 C356 152 398 96 462 118 C528 142 574 106 640 124 L640 560 L0 560Z" fill="url(#ridgeGreen)"/>
                  <path d="M0 246 C70 216 118 232 172 212 C242 188 286 226 350 198 C432 162 498 210 560 184 C596 168 620 166 640 170 L640 560 L0 560Z" fill="rgba(34,197,94,0.075)"/>
                  <path d="M0 330 C84 298 148 314 220 292 C300 268 358 308 432 274 C510 238 570 272 640 250 L640 560 L0 560Z" fill="rgba(15,118,110,0.12)"/>
                </g>

                <!-- Engineering contour lines over the mountains -->
                <g fill="none" stroke="rgba(34,211,238,0.08)" stroke-width="1">
                  <path d="M0 230 Q80 196 150 218 Q230 180 310 205 Q380 175 455 196 Q535 174 640 190"/>
                  <path d="M0 272 Q100 244 176 260 Q258 226 338 248 Q420 218 500 240 Q572 218 640 232"/>
                  <path d="M0 350 Q120 326 210 340 Q302 310 390 330 Q480 300 560 318 Q604 310 640 318"/>
                </g>

                <!-- Mountain road deck, perspective bend -->
                <path d="M-30 528 C80 474 142 430 214 402 C288 374 374 346 492 292 C550 266 598 244 670 210 L700 560 L-40 560Z"
                      fill="url(#roadDeck)" stroke="rgba(148,163,184,0.25)" stroke-width="1.5"/>
                <path d="M40 506 C124 462 174 430 238 404 C330 366 420 324 566 244"
                      fill="none" stroke="rgba(203,213,225,0.28)" stroke-width="2" stroke-dasharray="28,22" stroke-linecap="round"/>
                <path d="M15 534 C122 484 190 446 276 410 C380 366 470 322 620 246"
                      fill="none" stroke="rgba(249,115,22,0.22)" stroke-width="1.5" stroke-dasharray="8,10"/>

                <!-- Road / Route base path aligned to the mountain road -->
                <path d="M52 506 C118 470, 158 430, 224 402 S 350 350, 410 316 S 505 270, 590 226"
                      fill="none" stroke="rgba(148,163,184,0.15)" stroke-width="3" stroke-linecap="round"/>

                <!-- Animated route glow trail -->
                <path d="M52 506 C118 470, 158 430, 224 402 S 350 350, 410 316 S 505 270, 590 226"
                      fill="none" stroke="url(#trailGrad)" stroke-width="3.5" stroke-linecap="round"
                      stroke-dasharray="900" stroke-dashoffset="900" class="animate-path-draw" filter="url(#svgGlow)"/>

                <!-- Speed limit sign from reference photo, rendered as HUD-aware roadside marker -->
                <g transform="translate(505,218) rotate(-10)" class="animate-float" style="animation-duration:7s">
                  <line x1="0" y1="38" x2="0" y2="88" stroke="rgba(203,213,225,0.55)" stroke-width="3"/>
                  <circle cx="0" cy="20" r="20" fill="rgba(241,245,249,0.95)" stroke="#EF4444" stroke-width="5"/>
                  <text x="0" y="26" text-anchor="middle" fill="#0F172A" font-size="16" font-family="JetBrains Mono,monospace" font-weight="800">40</text>
                  <text x="0" y="-12" text-anchor="middle" fill="#F97316" font-size="7" font-family="JetBrains Mono,monospace">LIMIT</text>
                </g>

                <!-- Route waypoints -->
                <!-- WP 1: Factory -->
                <g>
                  <circle cx="62" cy="498" r="12" fill="rgba(34,211,238,0.15)" stroke="#22D3EE" stroke-width="2"/>
                  <circle cx="62" cy="498" r="4" fill="#22D3EE" filter="url(#svgGlow)"/>
                  <text x="62" y="524" text-anchor="middle" fill="#94A3B8" font-size="8" font-family="JetBrains Mono,monospace">WP-01</text>
                  <text x="62" y="536" text-anchor="middle" fill="#6B7280" font-size="7" font-family="JetBrains Mono,monospace">FACTORY</text>
                </g>
                <!-- WP 2: Bridge -->
                <g>
                  <circle cx="222" cy="402" r="10" fill="rgba(34,211,238,0.15)" stroke="#22D3EE" stroke-width="1.5"/>
                  <circle cx="222" cy="402" r="3.5" fill="#22D3EE" filter="url(#svgGlow)"/>
                  <text x="222" y="424" text-anchor="middle" fill="#94A3B8" font-size="8" font-family="JetBrains Mono,monospace">WP-02</text>
                  <text x="222" y="436" text-anchor="middle" fill="#6B7280" font-size="7" font-family="JetBrains Mono,monospace">CURVE</text>
                </g>
                <!-- WP 3: Mountain Pass -->
                <g>
                  <circle cx="408" cy="317" r="10" fill="rgba(249,115,22,0.2)" stroke="#F97316" stroke-width="1.5"/>
                  <circle cx="408" cy="317" r="3.5" fill="#F97316" filter="url(#svgGlow)"/>
                  <text x="408" y="338" text-anchor="middle" fill="#94A3B8" font-size="8" font-family="JetBrains Mono,monospace">WP-03</text>
                  <text x="408" y="350" text-anchor="middle" fill="#F97316" font-size="7" font-family="JetBrains Mono,monospace">LOW SPEED</text>
                </g>
                <!-- WP 4: Highway -->
                <g>
                  <circle cx="590" cy="226" r="10" fill="rgba(34,211,238,0.15)" stroke="#22D3EE" stroke-width="1.5"/>
