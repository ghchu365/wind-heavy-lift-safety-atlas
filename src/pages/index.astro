      <script>
        window.showCaseDetail = async function(id) {
          try {
            const res = await fetch(`/api/knowledge/cases?id=${id}`);
            const data = await res.json();
            const casesData = Array.isArray(data.data) ? data.data[0] : data.data;
            if (!casesData) {
              alert('案例不存在');
              return;
            }
            const c = casesData;
            const severityClass = c.severity === '重大' ? 'bg-red-500/20 text-red-400 border-red-500' : 'bg-orange-500/20 text-orange-400 border-orange-500';

            const modal = document.createElement('div');
            modal.id = 'case-modal';
            modal.className = 'fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm';
            modal.innerHTML = `
              <div class="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-3xl border border-white/10 bg-navy-950 p-8 relative">
                <button onclick="closeCaseModal()" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 text-white hover:bg-white/20 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
                <span class="inline-block rounded-full px-3 py-1 text-xs font-bold ${severityClass} border mb-4">${c.severity}</span>
                <h2 class="text-2xl font-black text-white mb-2">${c.title}</h2>
                <p class="text-sm text-steel-500 mb-6">${c.location || ''} | ${c.date || ''}</p>
                <div class="space-y-6 text-steel-300">
                  <div>
                    <h3 class="text-sm font-bold text-orange-safety mb-2">事故经过</h3>
                    <p class="leading-7">${c.description}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-orange-safety mb-2">原因分析</h3>
                    <p class="leading-7">${c.causes || c.cause || '暂无'}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-orange-safety mb-2">经验教训</h3>
                    <p class="leading-7">${c.lessons || '暂无'}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-orange-safety mb-2">预防措施</h3>
                    <p class="leading-7">${c.prevention}</p>
                  </div>
                </div>
              </div>
            `;
            document.body.appendChild(modal);
            modal.addEventListener('click', (e) => {
              if (e.target === modal) closeCaseModal();
            });
          } catch (error) {
            console.error('加载案例详情失败:', error);
            alert('加载失败，请重试');
          }
        };

        window.closeCaseModal = function() {
          const modal = document.getElementById('case-modal');
          if (modal) modal.remove();
        };

        loadAccidentCases();
      </script>

