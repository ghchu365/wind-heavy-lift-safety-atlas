  <body class="pb-20">
    <SiteParticles client:load />
    <header class="fixed left-0 right-0 top-0 z-50 px-4 pt-4 sm:px-6">
      <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-white/10 bg-navy-950/72 px-4 py-3 shadow-2xl shadow-black/30 backdrop-blur-xl sm:px-5">
