---
import '../styles/global.css';
import { SiteParticles } from '../components/SiteParticles';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="页面未找到 - 风电大件运输安全知识中心" />
    <meta name="theme-color" content="#040E1A" />
    <title>页面未找到｜风电大件运输安全知识中心</title>
  </head>
  <body>
    <SiteParticles client:load />

    <main class="relative flex min-h-screen flex-col items-center justify-center px-4 text-center">
      <div class="relative z-10 max-w-lg">
        <!-- Error code -->
        <p class="font-mono text-[10px] uppercase tracking-[0.32em] text-orange-safety">Error / 404</p>

        <!-- Large 404 graphic -->
        <div class="mt-8 font-display text-[8rem] font-black leading-none tracking-[-0.06em] text-white sm:text-[10rem]">
          <span class="headline-gradient">404</span>
        </div>

        <h1 class="mt-6 font-display text-3xl font-bold text-white sm:text-4xl">页面未找到</h1>
        <p class="mt-4 text-lg leading-8 text-steel-300">您访问的页面不存在或已被移除。<br />请检查链接是否正确，或返回首页继续浏览。</p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-full bg-orange-safety px-6 py-3 font-bold text-navy-950 shadow-xl shadow-orange-safety/25 transition hover:-translate-y-0.5 hover:bg-orange-safetyLight focus:outline-none focus:ring-2 focus:ring-orange-safety focus:ring-offset-2 focus:ring-offset-navy-950">
            返回首页
          </a>
          <a href="/#library" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 font-bold text-white backdrop-blur transition hover:-translate-y-0.5 hover:border-cyan-wind/50 hover:bg-cyan-wind/10 focus:outline-none focus:ring-2 focus:ring-cyan-wind focus:ring-offset-2 focus:ring-offset-navy-950">浏览知识库</a>
        </div>
      </div>

      <!-- Decorative scan line -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute left-1/2 top-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-wind/8 blur-3xl"></div>
        <div class="absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange-safety/8 blur-3xl"></div>
      </div>
    </main>
  </body>
</html>